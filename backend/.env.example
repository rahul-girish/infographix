# Infographix MLOps Backend Configuration
PROJECT_NAME="Infographix MLOps API"
API_V1_STR="/api/v1"
PORT=8000

# Supabase PostgreSQL Session Pooler URL (required in production; defaults to local SQLite if omitted)
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Standalone ClearML-backed Inference Service URL
INFERENCE_SERVICE_URL=https://your-inference-service.onrender.com
INFERENCE_TIMEOUT_SECONDS=120
DEFAULT_ENGINE=adaptation

# Allowed Frontend Origins
CORS_ORIGINS=["http://localhost:5173","https://your-frontend.onrender.com"]

# MLOps Governance Module Settings
GOV_AUTH_MODE=strict
GOV_JWT_SECRET=
GOV_JWT_AUDIENCE=
GOV_SERVICE_TOKENS={"ci-promote-token":{"actor_id":"ci-cd-promote","role":"admin"},"ci-train-token":{"actor_id":"ci-cd-train","role":"ml_engineer"},"drift-svc-token":{"actor_id":"drift-monitor","role":"ml_engineer"}}
GOV_CLEARML_MODE=mock
GOV_CLEARML_PROJECT_NAME=Infographix
GOV_SEED_DEFAULT_POLICIES=true
