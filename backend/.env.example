# Infographix Backend Configuration
PROJECT_NAME="Infographix API"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="infographix-development-secret-key-please-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=infographix
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/infographix

# Storage
UPLOAD_DIR=data/uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
