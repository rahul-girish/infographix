# Infographix MLOps Backend Configuration
PROJECT_NAME="Infographix MLOps API"
API_V1_STR="/api/v1"

# Supabase PostgreSQL Session Pooler URL (required in production; defaults to local SQLite if omitted)
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Allowed Frontend Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Default inference engine: "adaptation" (Retrieval + HiGHS LP) or "neural"
DEFAULT_ENGINE=adaptation
