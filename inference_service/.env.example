# Infographix Standalone Inference Service Configuration
SERVICE_NAME="Infographix Inference Service"
SERVICE_VERSION="1.0.0"
PORT=8001
LOG_LEVEL=INFO

# ClearML Model Registry Credentials (required)
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_PROJECT_NAME=Infographix
CLEARML_FORCE_DOWNLOAD=false

# Explicit ClearML Model Selection (immutable version or explicit model ID required)
RETRIEVER_MODEL_FAMILY=poster_layout_retriever
RETRIEVER_MODEL_VERSION=v2.0.0
# RETRIEVER_MODEL_ID=

NEURAL_MODEL_FAMILY=poster_layout_generator
NEURAL_MODEL_VERSION=v0.1.0
# NEURAL_MODEL_ID=

DEFAULT_ENGINE=neural
TORCH_DEVICE=cpu

# Adaptation & Template Geometry Dataset (elements.parquet)
# Option 1: Mounted persistent file path
ELEMENTS_PARQUET_PATH=/app/data_cache/elements.parquet
# Option 2: Remote HTTPS URL + SHA-256 checksum
# ELEMENTS_PARQUET_URL=
# ELEMENTS_PARQUET_SHA256=4a491581bd20a770fd244e5dfcce7a943ba2be97e368c11dc7dc8cf96bf0d651
# Option 3: ClearML Dataset
# CLEARML_DATASET_ID=
# Option 4: Minidvc snapshot
# MINIDVC_SNAPSHOT=v2
# MINIDVC_CLIENT_ID=
# MINIDVC_CLIENT_SECRET=
# MINIDVC_REFRESH_TOKEN=

CORS_ORIGINS=["http://localhost:8000"]
