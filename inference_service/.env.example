# Infographix Standalone Inference Service Configuration
SERVICE_NAME="Infographix Inference Service"
SERVICE_VERSION="1.0.0"
PORT=8001
LOG_LEVEL=INFO

# ClearML Model Registry Credentials (required)
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_PROJECT_NAME=Infographix
CLEARML_FORCE_DOWNLOAD=false

# Explicit ClearML Neural Model Selection (immutable version or explicit model ID required)
NEURAL_MODEL_FAMILY=poster_layout_generator
NEURAL_MODEL_VERSION=v0.2.0
NEURAL_MODEL_VERSION=v0.2.0
# NEURAL_MODEL_ID=

DEFAULT_ENGINE=neural
NEURAL_USE_REFINER=true
TORCH_DEVICE=cpu
USE_COLUMN_GRID_REFINER=true

# Optional Bearer token to protect /metrics in production (leave blank for open scrape)
# METRICS_AUTH_TOKEN=

# Optional mutual keep-alive ping to backend service (prevents Render free-tier idle spin-down)
# BACKEND_SERVICE_URL=https://your-backend-service.onrender.com
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=600
KEEPALIVE_TIMEOUT_SECONDS=10

CORS_ORIGINS=["http://localhost:8000"]
